  "steps": [
    {
      "instruction": "Combine the lamb, beef, breadcrumbs, eggs, feta, red onion, garlic, lemon zest, oregano, rosemary, parsley, salt and pepper. Mix until just combined, taking care not to overmix."
    },
    {
      "instruction": "To test for seasoning, fry a small amount of the mixture and adjust salt and pepper as needed."
    },
    {
      "instruction": "With wet hands, form meatballs approximately 3cm/1in in diameter and place on a chopping board.",
      "options": {
        "Pan-fry": [
          {
            "instruction": "Pre-heat a non-stick frying pan over medium-high and add the olive oil. Fry the meatballs in batches until golden brown on all sides and cooked through."
          }
        ],
        "Bake": [
          {
            "instruction": "Pre-heat the oven to 220°C. Line 2 baking sheets with baking paper and arrange the meatballs with space between them. Drizzle with 1–2 tbsp olive oil and bake, turning halfway, until golden brown and cooked through, approximately 20–30 minutes."
          }
        ]
      }
    },
    {
      "instruction": "Remove from the heat, optionally drizzle with lemon juice, and serve."
    }
  ]
