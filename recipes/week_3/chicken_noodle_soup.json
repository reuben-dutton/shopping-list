  "steps": [
    {
      "instruction": "In a large pot, heat 3 tbsp olive oil over medium-high. Add the ground chicken, season generously with salt and pepper, and cook, breaking up with a wooden spoon, until starting to crumble, about 3 minutes."
    },
    {
      "instruction": "Add the garlic, coriander and celery seeds (if using) to the chicken and cook, stirring frequently, until the chicken is cooked through, about 2 minutes. Using a slotted spoon, scoop the chicken into a small lidded bowl to retain moisture; cover and set aside."
    },
    {
      "instruction": "Add the celery, carrot, shallot, thyme and remaining 2 tbsp olive oil to the pot. Season with salt and pepper and cook, stirring, until slicked with fat, about 3 minutes."
    },
    {
      "instruction": "Add the chicken stock (1.75L for a stew-like soup, up to 2L for a brothy soup) and bring to a boil over high heat."
    },
    {
      "instruction": "Add the noodles and cook over medium-high heat until al dente according to package directions. If the noodles absorb a lot of liquid, add more stock to taste."
    },
    {
      "instruction": "Add the reserved chicken and any accumulated juices and heat until warmed through. Season to taste with salt and pepper."
    },
    {
      "instruction": "Divide among bowls and top each with a spoonful of crème fraîche, a handful of torn parsley and dill, and lemon zest."
    }
  ]
