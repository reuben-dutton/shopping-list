  "steps": [
    {
      "instruction": "Make the marinade: combine cornflour, soy sauce, five spice and sesame oil in a jug and stir until smooth. Add the beef to a shallow dish with half the marinade and toss to coat. Cover and refrigerate for 30 minutes if time permits. Stir the chicken stock into the remaining marinade and set aside as sauce."
    },
    {
      "instruction": "Cook the noodles according to packet directions. Drain and transfer to a bowl."
    },
    {
      "instruction": "Heat a large wok over high heat. Add 2 tsp of the peanut oil and swirl to coat. Stir-fry a third of the beef for 2–3 minutes until browned. Transfer to a bowl and cover to keep warm. Repeat with the remaining oil and beef in 2 more batches."
    },
    {
      "instruction": "Add the remaining peanut oil to the wok over high heat and swirl to coat. Add the red onion and stir-fry for 2 minutes until softened. Add the garlic and ginger and stir-fry for 1 minute until fragrant."
    },
    {
      "instruction": "Add the noodles and sauce mixture to the wok. Stir-fry for 2 minutes. Add the buk choy and snow peas and stir-fry for 1 minute until almost tender."
    },
    {
      "instruction": "Return the beef to the wok and stir-fry for 1–2 minutes until heated through. Serve topped with bean sprouts and sliced chilli."
    }
  ]
