  "steps": [
    {
      "instruction": "Dice the carrots, celery and onion into small chunks (about ½cm). Add to the slow cooker along with the minced garlic, thyme and parsley."
    },
    {
      "instruction": "Cook the sausages in a large frying pan with the oil over medium heat until lightly browned on the outside, 1–2 minutes. Add the pork lardons and cook until golden at the edges and the sausages are a deeper colour, a further 1–2 minutes. Transfer the sausages and lardons to the slow cooker."
    },
    {
      "instruction": "Drain any excess fat from the pan and return to the heat. Add the white wine and simmer over medium-high heat for 2–3 minutes to evaporate the alcohol."
    },
    {
      "instruction": "Dissolve the stock cube in the hot water. Pour the reduced wine, chopped tomatoes, tomato puree, chicken stock, sugar, paprika and black pepper into the slow cooker."
    },
    {
      "instruction": "Add the haricot beans, butter beans and bay leaves. Stir gently to combine, ensuring the bay leaves are submerged. Cook on low for 6–8 hours."
    },
    {
      "instruction": "At the end of cooking, stir gently to keep the beans and sausages intact. Taste and add salt if needed. Remove the bay leaves and serve."
    }
  ]
