  "steps": [
    {
      "instruction": "Rinse and drain the quinoa. Add to a small pot with 2 cups of water and bring to a boil. Reduce to a simmer, cover and cook for 15 minutes. Fluff with a fork and let cool for 5–10 minutes."
    },
    {
      "instruction": "In a large bowl, combine the cooled quinoa, cucumber, parsley, mint, red onion, pistachios, chickpeas, lemon juice, olive oil, salt, pepper and feta. Stir together until well mixed."
    },
    {
      "instruction": "Serve immediately or refrigerate for a couple of hours before serving. Store in an airtight container for up to 5 days."
    }
  ]
