  "steps": [
    {"instruction": "Combine marmalade, sauces, juice and garlic in a bowl."},
    {"instruction": "Season pork with salt and pepper. Heat oil in a frying pan over medium-high heat. Cook pork, turning, for 5 to 10 minutes or until browned."},
