    {"measurement": {"unit": null, "amount": 1}, "name": "onion", "variety": "brown", "intrinsics": ["large"], "preparation": ["finely chopped"], "category": "Produce", "optional": false, "staple": false},
    {"measurement": {"unit": "cup", "amount": 0.25}, "name": "curry paste", "variety": "green", "intrinsics": [], "preparation": [], "category": "Condiments & Sauces", "optional": false, "staple": false},
