  "steps": [
    {
      "instruction": "Chop the chicken into 1 inch pieces. Whisk together the eggs, soy sauce and cooking wine in a bowl, add the chicken and stir to combine. Cover and chill for 30 minutes (5-10 minutes is enough if you are short on time)."
    },
    {
      "instruction": "Transfer the chicken pieces to a large zip-lock bag and discard the marinade. Add the corn starch to the bag, seal, and shake to coat the chicken completely."
    },
    {
      "instruction": "Add the oil to a large pan or skillet and bring to medium-high heat. Transfer the chicken to the pan, arranging the pieces so they are not piled on top of each other. Cook for 3-4 minutes, then turn the pieces and cook another 3-4 minutes until golden brown."
    },
    {
      "instruction": "Use a slotted spoon to transfer the chicken to a paper-towel lined plate. Discard any excess oil in the pan and wipe it out with a paper towel."
    },
    {
      "instruction": "Pour the Lemon Sauce into the pan and bring to a boil over medium-high heat."
    },
    {
      "instruction": "In a small bowl whisk together the cold chicken broth and corn starch until dissolved. Add to the boiling sauce, then reduce the heat to medium-low and stir until thickened."
    },
    {
      "instruction": "Return the chicken to the pan and stir for 2-3 minutes until hot throughout. Garnish with sesame seeds and sliced green onions and serve over the cooked rice."
    }
  ]
