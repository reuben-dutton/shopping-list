  "steps": [
    {
      "instruction": "Reserve the green tops of the spring onions. Thinly slice the whites. Heat half of the oil in a medium saucepan over medium heat. Add the sliced onion and cook, stirring often, for 2 minutes or until soft."
    },
    {
      "instruction": "Add the cauliflower, 3 cups of the corn, the stock, the Cajun seasoning and 1 cup water. Bring to a simmer, then reduce the heat to low and simmer for 15 minutes. Cool slightly, then use a handheld blender to purée until a chunky cream-like texture forms."
    },
    {
      "instruction": "Return to a medium heat. Stir in the remaining corn and ⅓ cup of the cream. Cook for 3 minutes or until the corn kernels are tender and heated through. Season, then cover to keep warm."
    },
    {
      "instruction": "Heat the remaining oil in a large frying pan over medium heat. Add the bacon and cook, stirring occasionally, for 4 minutes or until golden."
    },
    {
      "instruction": "Thinly slice the reserved onion greens. Divide the soup among bowls, drizzle with the remaining cream, then top with the bacon and onion and serve."
    }
  ]
}