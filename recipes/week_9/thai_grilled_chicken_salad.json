  "steps": [
    {
      "instruction": "Prepare the Marinade. Add the chicken thigh fillets, turning to ensure each piece is well coated. Cover and refrigerate for at least 30 minutes."
    },
    {
      "instruction": "Prepare the Peanut Dressing."
    },
    {
      "instruction": "Heat a grill pan over medium-high heat and add the vegetable oil. Remove the chicken from the marinade, allowing any excess to drip off. Grill the chicken for 5-6 minutes on each side until crispy, golden and cooked through. Transfer to a plate to rest, then slice."
    },
    {
      "instruction": "In a large bowl, combine the wombok, carrot, capsicum, bean sprouts, coriander, mint and the Thai basil. Add the Peanut Dressing and toss to coat well."
    },
    {
      "instruction": "Arrange the salad on a platter or individual plates and top with the sliced chicken. Garnish with the peanuts, lime wedges and extra Thai basil leaves and serve immediately."
    }
