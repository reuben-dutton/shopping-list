  "steps": [
    {
      "instruction": "Season the veal cutlets with salt and pepper, pressing lightly so it adheres. Spread the flour on a plate and dredge each piece of veal until lightly coated, shaking off any excess."
    },
    {
      "instruction": "Heat the olive oil in a large skillet over high heat. Working in batches, fry the veal for 1 minute on each side until browned and cooked through, adding more oil as needed. Remove from the pan and set aside on a plate."
    },
    {
      "instruction": "Add the butter to the pan. Once melted, add the mushrooms with a pinch of salt and fry for 5–7 minutes until the excess moisture has been released and the mushrooms begin to cook down."
    },
    {
      "instruction": "Add the garlic and fry for 1 minute until fragrant. Pour in the Marsala wine and let it simmer until the liquid has reduced by half."
    },
    {
      "instruction": "Add the chicken stock and simmer for 5–7 minutes until the sauce starts to thicken. Return the veal to the pan to warm through."
    },
    {
      "instruction": "Serve the veal Marsala with a sprinkle of freshly chopped parsley."
    }
  ]
