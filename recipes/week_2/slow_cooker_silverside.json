  "steps": [
    {
      "instruction": "Place the onions, carrot, garlic and bay leaves in the base of the slow cooker. Place the silverside roast on top of the vegetables. Add the brown sugar, malt vinegar, beef stock and enough water so the silverside is almost fully submerged."
    },
    {
      "instruction": "Cook on low for 6½ hours until the meat is tender and slightly falling apart."
    },
    {
      "instruction": "Allow the silverside to rest for 10 minutes under foil before slicing."
    },
    {
      "instruction": "Serve with mashed potato, the vegetables from the slow cooker and green beans."
    }
  ]
