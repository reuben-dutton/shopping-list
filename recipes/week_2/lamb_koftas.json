  "steps": [
    {
      "instruction": "Grate the onion into a large bowl using a standard box grater. Add the lamb mince, panko breadcrumbs, 2 crushed garlic cloves, fresh coriander and all kofta spices (cumin, ground coriander, paprika, cinnamon, cayenne, salt and pepper). Mix well with your hands until thoroughly combined."
    },
    {
      "instruction": "With damp hands, divide the meat mixture into 8 equal portions. Press and shape each portion onto a skewer, smoothing the surface."
    },
    {
      "options": {
        "Stove": [
          {
            "instruction": "Heat 1/2 tbsp oil in a large skillet over medium-high heat. Cook koftas in batches for about 5 minutes total, turning to brown evenly all over."
          }
        ],
        "BBQ": [
          {
            "instruction": "Cook koftas on a medium-high BBQ for about 6 minutes, rotating to brown evenly all over."
          }
        ],
        "Broiler": [
          {
            "instruction": "Preheat broiler/oven grill and cook koftas 30cm from the heat source for 12 minutes, rotating as needed until lightly browned."
          }
        ]
      }
    },
    {
      "instruction": "Serve as a DIY spread: lay out warm flatbreads, yoghurt sauce and salad. To assemble, smear flatbread with yoghurt sauce, top with salad then kofta, and drizzle with extra yoghurt sauce."
    }
  ]
