  "steps": [
    {
      "instruction": "Preheat oven to 170°C (150°C fan-forced). Heat 1 tsp oil in a large flameproof casserole dish over high heat. Working in 2 batches, cook the chicken for 1–2 minutes each side until golden. Transfer to a plate."
    },
    {
      "instruction": "Heat the remaining 1 tsp oil in the same dish over medium heat. Add the onion, celery and carrot and cook, stirring, for 5 minutes until softened. Add the garlic and cook for 30 seconds until fragrant."
    },
    {
      "instruction": "Return the chicken to the dish. Stir in the wholegrain mustard, chicken stock, apricot nectar and dried apricots and bring to the boil. Cover the dish with a lid or foil."
    },
    {
      "instruction": "Bake for 40 minutes, adding the cannellini beans for the last 10 minutes of cooking time."
    },
    {
      "instruction": "Serve with steamed snow peas and broccolini."
    }
  ]
